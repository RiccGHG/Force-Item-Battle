{
  "namespace": "hud",

  "hud_title_text": {
    "type": "image",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "size": ["100%c + 12px", "100%c + 5px"],
    "offset": [0, 22],
    "texture": "textures/ui/hud_tip_text_background",
    "alpha": "@hud.anim_actionbar_text_background_alpha_out",
    "controls": [
      {
        "title_message": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "color": "white",
          "layer": 31,
          "text": "$title_text",
          "alpha": "@hud.anim_actionbar_text_alpha_out"
        }
      },
      {
         "subtitle_frame": {
          "type": "panel",
          "controls": [
            {
              "subtitle": {
                "type": "label",
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "color": "$title_command_text_color",
                "enable_profanity_filter": true,
                "text": "#text",
                "$hud_subtitle_text": "$subtitle_text",
                "layer": 31,
                "localize": false,
                "visible": "false",
                "text_alignment": "center",
                "bindings": [
                  {
                    "binding_name": "#hud_subtitle_text_string",
                    "binding_name_override": "#text",
                    "binding_type": "global"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "item_image": {
    "type": "image",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [100, 100],
    "bindings": [
        {
            "binding_name": "#hud_subtitle_text_string"
        },
      {
        "binding_type": "view",
        "source_property_name": "(not (#hud_subtitle_text_string = 'hi'))",
        "target_property_name": "#visible"
      },
      {
        "binding_name": "#hud_subtitle_text_string",
        "binding_name_override": "#texture"
      }
    ]
  },

  "logo_image": {
    "type": "image",
    "texture": "hud_title_text@$hud_subtitle_text",
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "size": [100, 100],
    "visible": "true"
  },
  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": {
          "item_image@hud.item_image": {}
        }
      },
       {
        "array_name": "controls",
        "operation": "insert_front",
        "value": {
          "logo_image@hud.logo_image": {}
        }
      }
    ]
  }
}
